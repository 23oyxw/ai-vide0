FROM python:3.11-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y build-essential git curl ffmpeg fonts-noto-cjk && rm -rf /var/lib/apt/lists/*

# Install runtime requirements
COPY requirements.txt /app/requirements.txt
RUN pip install --upgrade pip && pip install -r /app/requirements.txt

EXPOSE 8765
# Source is mounted by docker-compose for live development
