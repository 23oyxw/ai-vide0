# ── AI Gateway (Vercel) ──────────────────────────────────────────
# Required for /api/chat streaming. Pull from Vercel: vercel env pull .env.local
AI_GATEWAY_API_KEY=
AI_GATEWAY_URL=https://gateway.ai.vercel.ai/v1

# ── Orchestrator (FastAPI, local or Railway) ─────────────────────
ORCHESTRATOR_URL=http://127.0.0.1:8765

# ── Database (optional, L6+) ───────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/ai_video
POSTGRES_URL=

# ── Storage & queue (optional, L5–L8) ─────────────────────────────
KV_REST_API_URL=
KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=

# ── Auth (optional) ───────────────────────────────────────────────
# NEXTAUTH_SECRET=
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ── Webhooks (optional, render worker) ────────────────────────────
WEBHOOK_SECRET=
RENDER_WORKER_URL=

# Copy to .env.local for local dev:
#   copy .env.example .env.local
