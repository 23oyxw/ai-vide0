{
  "name": "ai-video-orchestrator",
  "private": true,
  "workspaces": ["apps/web"],
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/start-dev.ps1",
    "dev:web": "npm run dev --workspace=web",
    "dev:web:clean": "npm run dev:clean --workspace=web",
    "dev:api": "uvicorn orchestrator.main:app --reload --host 127.0.0.1 --port 8765",
    "verify": "powershell -ExecutionPolicy Bypass -File scripts/verify-all.ps1",
    "verify:rag": "powershell -ExecutionPolicy Bypass -File scripts/verify-rag.ps1",
    "run:url": "powershell -ExecutionPolicy Bypass -File scripts/run-from-url.ps1",
    "build:web": "npm run build --workspace=web",
    "lint:web": "npm run lint --workspace=web",
    "dev:orchestrator": "uvicorn orchestrator.main:app --reload --port 8765",
    "test": "python -m pytest tests/ -v -x --tb=short",
    "test:unit": "python -m pytest tests/test_unit_*.py -v --tb=short",
    "test:api": "python -m pytest tests/test_integration_api.py -v --tb=short",
    "test:edge": "python -m pytest tests/test_edge_cases.py -v --tb=short",
    "test:coverage": "python -m pytest tests/ -v --cov=orchestrator --cov-report=term-missing"
  }
}