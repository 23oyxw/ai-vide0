# Orchestrator
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8765

# Database / Cache
POSTGRES_URL=postgres://orchestrator:orchestrator@postgres:5432/ai_video
DATABASE_URL=${POSTGRES_URL}
REDIS_URL=redis://redis:6379/0

# RAG / storage
RAG_KNOWLEDGE_DIR=/data/knowledge
RAG_CACHE_DIR=/data/rag_cache
RAG_CHROMA_DIR=/data/chroma_db
DATA_ROOT=/data

# Local tooling paths (inside container)
VIDEO_FACTORY_PATH=/app/video-factory
AI_KOUBO_PATH=/app/ai-koubo-platform

# AI keys (set on host or CI)
ZHIPU_API_KEY=
DEEPSEEK_API_KEY=
COGVIDEO_MODEL=cogvideox-3
